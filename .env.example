# ===================================================================
# Database Configuration
# ===================================================================
# REQUIRED: PostgreSQL connection settings
POSTGRES_DB=vtt_transcribe
POSTGRES_USER=vtt_user
POSTGRES_PASSWORD=change_me_in_production  # REQUIRED - Change in production!
POSTGRES_PORT=5432
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# REQUIRED: Full database URL used by the API service
# Format: postgresql://user:password@host:port/database
# Example: DATABASE_URL=postgresql://vtt_user:your_secure_password@db:5432/vtt_transcribe
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}

# ===================================================================
# OpenAI API
# ===================================================================
# REQUIRED: Your OpenAI API key for transcription
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===================================================================
# API Configuration
# ===================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# ===================================================================
# Security
# ===================================================================
# REQUIRED: Change to a secure random string in production!
# Generate SECRET_KEY, ENCRYPTION_KEY, and SESSION_SECRET with: uv run python scripts/generate_secrets.py
SECRET_KEY=change_me_to_random_string_in_production
ENCRYPTION_KEY=change_me_to_fernet_key_in_production
SESSION_SECRET=change_me_to_random_string_for_oauth_sessions
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===================================================================
# CORS
# ===================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===================================================================
# Storage
# ===================================================================
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=104857600

# ===================================================================
# Logging
# ===================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json


# ===================================================================
# Frontend
# ===================================================================
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# ===================================================================
# OAuth Providers (Optional)
# ===================================================================
# Required for OAuth authentication: Set FRONTEND_URL to your frontend URL
# Also configure OAuth apps with each provider and set both CLIENT_ID and CLIENT_SECRET
# Security: Only providers with BOTH id and secret will be enabled

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Job queue, retention and email (all optional) ---
# Jobs run one at a time, in order. Run a single API process (the queue lives in it).
# VTT_DATA_DIR=/app/jobs                # uploaded audio; keep it on a persistent volume
# VTT_DEFAULT_RETENTION_DAYS=7          # platform default: keep results 7 days (users can override)
# VTT_DELETE_GRACE_MINUTES=15           # retention "delete": removed this long after the first download
# VTT_DELETE_UNDOWNLOADED_HOURS=24      # ...or this long after finishing if never downloaded
# VTT_SWEEP_INTERVAL_SECONDS=300        # how often expired jobs are deleted
# VTT_PUBLIC_URL=https://vtt.example.com   # base URL for links in emails
# Under docker compose a local Postfix relay (service `mail`) is used by default: set VTT_MAIL_DOMAIN to your domain.
# VTT_MAIL_DOMAIN=example.com
# RELAYHOST=[smtp.example.com]:587     # optional: send through a provider instead of delivering directly
# SMTP_HOST=smtp.example.com            # use your own server instead of the bundled relay; empty switches email off
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=VTT Transcribe <vtt@example.com>
# SMTP_STARTTLS=true
